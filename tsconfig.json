{
  "compilerOptions": {
    "target": "es2022",
    // keep legacy class field semantics, typeorm entities rely on it
    "useDefineForClassFields": false,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "./build",
    "declaration": false, // don't generate d.ts files

    "strict": true,
    "useUnknownInCatchVariables": false,
    "noImplicitAny": false,
    "strictPropertyInitialization": false,

    // required by typeorm, routing-controllers and type-graphql (bun reads these too)
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": false, // don't generate js.map files
    "esModuleInterop": true,
    "skipLibCheck": true,

    "jsx": "react-jsx",
    "types": ["node", "bun", "jest", "./src/types/types.d.ts"]
  },
  "include": ["src"]
}
